# Object store holding the published Parquet datasets.
#
# Copy to .env for local development. In production these are supplied as
# environment variables instead. The values are read only by lib/s3.ts, which is
# server-only — Next exposes just NEXT_PUBLIC_* names to the browser, so the
# access key and secret never reach the client bundle.

# Required
S3_ENDPOINT=https://ncsa.osn.xsede.org
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional — defaults shown. Must match the bucket/prefix that
# modules/csv_to_parquet_s3.py publishes to.
# S3_BUCKET=ot-data-catalog
# S3_PREFIX=tlpa/wq
# S3_REGION=us-east-1

# Optional — Cache-Control the /api/data route sends to the browser.
# S3_PROXY_CACHE_CONTROL=public, max-age=300, must-revalidate